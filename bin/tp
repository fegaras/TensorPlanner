#/bin/bash

exec() { echo "\$ $@" ; "$@" ; }

if [ -z $block_size ]; then
   block_size=1000
fi

if [ -z $use_GPU ]; then
   use_GPU=false
fi

echo "import edu.uta.diablo._
import Math._
object Test {
  def main ( args: Array[String] ) {
    parami(block_dim_size,$block_size)
    param(use_GPU,$use_GPU)
    param(asynchronous,true)
    //param(trace,false)
    param(cxx_generation,true)
    q(\"\"\"" >cxxgen.sc

cat $1  >>cxxgen.sc

echo "\"\"\")
  }
}" >>cxxgen.sc

mkdir -p classes
scalac -d classes -cp ${JARS} cxxgen.sc >cxxgen.log

mlir-opt mlir_output.mlir \
  --pass-pipeline="builtin.module(
    lower-affine, \
    gpu-kernel-outlining, \
    convert-scf-to-cf, \
    expand-strided-metadata, \
    nvvm-attach-target{chip=sm_80 features=+ptx80 O=3}, \
    gpu.module(convert-scf-to-cf, convert-nvgpu-to-nvvm), \
    finalize-memref-to-llvm, \
    gpu.module(convert-gpu-to-nvvm{index-bitwidth=0 use-bare-ptr-memref-call-conv}), \
    canonicalize, \
    cse, \
    gpu-to-llvm, \
    finalize-memref-to-llvm, \
    reconcile-unrealized-casts)" \
    -o lowered.mlir

python3 ${DIABLO_HOME}/utils/extract_gpu_kernel.py lowered.mlir mlir_output.ptx

if [ "$use_GPU" == "true" ]; then
  if [ "$debug" == "y" ]; then
    exec g++ -g cxxgen.cpp -fopenacc -foffload=nvptx-none -fcf-protection=none -fno-stack-protector -no-pie -I${DIABLO_HOME}/include -L${DIABLO_HOME}/lib -ldiablo -I$MPI_HOME/include -Iinclude -L$MPI_HOME/lib -Wl,-rpath -Wl,$MPI_HOME/lib -lmpi
  else
    exec mpicxx -O3 -DNDEBUG cxxgen.cpp -acc -gpu=cc80 -I${DIABLO_HOME}/include -L${DIABLO_HOME}/lib -ldiablo -I${CUDA_HOME}/include -L${CUDA_HOME}/targets/x86_64-linux/lib/stubs -lcuda -L${CUDA_HOME}/lib64 -lcudart
  fi
else
  if [ "$debug" == "y" ]; then
    exec mpic++ -g cxxgen.cpp -fopenmp -I${DIABLO_HOME}/include -L${DIABLO_HOME}/lib -ldiablo
  else
    exec mpic++ -O3 -DNDEBUG cxxgen.cpp -fopenmp -I${DIABLO_HOME}/include -L${DIABLO_HOME}/lib -ldiablo
  fi
fi
