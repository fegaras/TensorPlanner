#!/bin/bash
#SBATCH --job-name=ray_train
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=00:05:00
#SBATCH --output=ray_%j_out.log
#SBATCH --error=ray_%j_err.log

source ~/TP_GPU/setup.sh

MASTER_NODE=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n 1)
MASTER_PORT=6379
NUM_GPUS_PER_NODE=4
NUM_CPUS_PER_NODE=16
export ip_head=$MASTER_NODE:$MASTER_PORT

# This script is run by srun on every node
cat << 'EOF' > /tmp/start_ray_$SLURM_JOB_ID.sh
#!/bin/bash
source ~/.venv/bin/activate

MASTER_NODE=$1
MASTER_PORT=$2
NODE_ID=$SLURM_NODEID

if [ "$NODE_ID" -eq 0 ]; then
    ray start --head \
        --port=$MASTER_PORT \
        --num-cpus=16 \
        --num-gpus=4 \
        --block
else
    sleep 15  # wait for head to start
    ray start \
        --address="$MASTER_NODE:$MASTER_PORT" \
        --num-cpus=16 \
        --num-gpus=4 \
        --block
fi
EOF
chmod +x /tmp/start_ray_$SLURM_JOB_ID.sh

# Launch Ray on all nodes in background
srun --mpi=pmi2 /tmp/start_ray_$SLURM_JOB_ID.sh $MASTER_NODE $MASTER_PORT &
SRUN_PID=$!

# Wait for cluster to form then launch training from head
sleep 30
echo "Cluster status:"; ray status --address="$MASTER_NODE:$MASTER_PORT"
n=$((128*1024))
m=$((32*1024))
iterations=10
echo "n: ${n}, m: ${m}, epochs: ${iterations}"
python lr_ray.py $n $m $iterations \
    --num_workers $((SLURM_NNODES * NUM_GPUS_PER_NODE)) \
    --use_gpu

ray stop
