var n = args(0).toInt;
var m = args(1).toInt;
var iterations = args(2).toInt;
var lrate = 0.005/n;
var max_rand = 1000000;
var upper_bound = 1000000.0;

var X_d = tensor*(n,m)[ ((i,j),0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1), j <- 0..(m-1) ];
var Y_d = tensor*(n)[ (i,0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1) ];

var layer = 4096;
var w1 = tensor*(m,layer) [ ((i,j),0.5-(random()%max_rand)/upper_bound) | i <- 0..(m-1), j <- 0..(layer-1)];
var w2 = tensor*(layer) [ (i,0.5-(random()%max_rand)/upper_bound) | i <- 0..(layer-1) ];

var Z_arr1 = tensor*(n,m) [ ((i,j),0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1), j <- 0..(m-1)];
var Z_arr2 = tensor*(n) [ (i,0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1)];
var A_arr1 = tensor*(n,m) [ ((i,j),0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1), j <- 0..(m-1)];
var A_arr2 = tensor*(n,m) [ ((i,j),0.5-(random()%max_rand)/upper_bound) | i <- 0..(n-1), j <- 0..(m-1)];

var iter = 0;
while(iter < iterations) {
    iter = iter + 1;
    var A_curr = X_d;
    A_arr1 = A_curr;
    Z_arr1 = tensor*(n,layer) (A_curr @ w1);
    A_curr = tensor*(n,layer)[ ((i,j),max(z,0.0)) | ((i,j),z) <- Z_arr1 ];

    A_arr2 = A_curr;
    Z_arr2 = tensor*(n) (A_curr @ w2);

    var dA_prev1 = tensor*(n) (Y_d-Z_arr2);
    var dA2 = dA_prev1;
    var dZ2 = tensor*(n) (dA2 * Z_arr2);
    var dW_curr2 = tensor*(layer) (A_arr2.t @ dZ2);
    var dA_prev2 = tensor*(n,layer)[ ((i,j),1.0) | i <- 0..(n-1), j <- 0..(layer-1) ];
    dA_prev2 = [ ((i,j),z) | ((i,j),a) <- dA_prev2, (ii,z) <- dZ2, i == ii ];
    dA_prev2 = [ ((i,j),da*w) | ((i,j),da) <- dA_prev2, (jj,w) <- w2, j == jj ];
    w2 = tensor*(layer) (w2-lrate*dW_curr2);

    var dA1 = dA_prev2;
    var dZ1 = tensor*(n,layer)[ ((i,j),max(z,0.0)*a) | ((i,j),a) <- dA1, ((ii,jj),z) <- Z_arr1,
                            i == ii, j == jj ];
    var dW_curr1 = tensor*(m,layer) (A_arr1.t @ dZ1);
    w1 = tensor*(m,layer) (w1-lrate*dW_curr1);
}
w2;
